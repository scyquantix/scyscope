{
  "name": "scyscope",
  "version": "0.1.0",
  "private": true,
  "description": "ScyScope, da ScyQuantix: explorador SQL de dados públicos do Brasil (SICONFI, TCE-SP, IBGE, BACEN), um esquema por API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
